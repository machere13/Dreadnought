{
  "name": "dreadnought",
  "private": true,
  "packageManager": "pnpm@9.6.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "catalog": "node tools/catalog/src/cli.mjs",
    "catalog:test": "vitest run tools/catalog/tests --maxWorkers=1",
    "dev": "pnpm --filter @dreadnought/example-react dev",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.type-tests.json --noEmit",
    "storybook": "pnpm build && pnpm --filter @dreadnought/storybook dev",
    "storybook:build": "pnpm build && pnpm --filter @dreadnought/storybook build:storybook",
    "docs": "pnpm --filter @dreadnought/docs dev",
    "docs:build": "pnpm --filter @dreadnought/docs build",
    "docs:refresh": "pnpm --filter @dreadnought/docs refresh:knowledge"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
