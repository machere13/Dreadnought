{
  "name": "dreadnought",
  "private": true,
  "packageManager": "pnpm@9.6.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @dreadnought/example-react dev",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.type-tests.json --noEmit",
    "storybook": "pnpm build && pnpm --filter @dreadnought/storybook dev",
    "storybook:build": "pnpm build && pnpm --filter @dreadnought/storybook build:storybook"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
